# -----------------------------------------------------------------------------
# Quiz App - Environment Variables Configuration Template
# -----------------------------------------------------------------------------

# Public Application URL (used for interaction callbacks and share links)
NUXT_PUBLIC_APP_URL=https://quiz.example.com

# Application Brand Name
NUXT_PUBLIC_APP_NAME=Community Quiz

# Secret used to sign and verify session JWTs for quiz players
# Generate with: openssl rand -base64 48
NUXT_JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# Discord Application Public Key (hex string from Discord Developer Portal)
# Used to verify ed25519 signatures on incoming Discord bot interaction webhooks
NUXT_DISCORD_PUBLIC_KEY=your_discord_application_public_key_hex

# Administrative Token used to authorize back-office and maintenance operations
# (ranking generation, fraud audits, stats calculation, prize draws)
# Generate with: openssl rand -base64 48
NUXT_ADMIN_TOKEN=your_secure_admin_authorization_token

# Discord Ranking Webhook or Channel Endpoint (optional)
DISCORD_RANKING_CHANNEL_ID=your_discord_channel_id
DISCORD_RANKING_MESSAGE_ID=your_discord_message_id

# Cloudflare Configuration (for deployment via Wrangler CLI)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
